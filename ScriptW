local function LNII_fake_script() -- MFrame.MainScript 
	local script = Instance.new('LocalScript', MFrame)

	local button = script.Parent.ApplyButton
	local textBox = button.Parent:WaitForChild("SpeedBox")
	local button2 = script.Parent.Normal
	local player = game.Players.LocalPlayer
	local gui = script.Parent.Parent.MFrame
	local runService = game:GetService("RunService")
	local player = game:GetService("Players").LocalPlayer
	local tweenService = game:GetService("TweenService")
	local UIS = game:GetService("UserInputService")
	
	
	-- Create UIScale
	local scale = Instance.new("UIScale")
	scale.Parent = gui
	
	-- Base resolution (what you designed your UI for)
	local baseResolution = Vector2.new(1920, 1080)
	
	-- Function to update scale
	local function updateScale()
		local camera = workspace.CurrentCamera
		if not camera then return end
	
		local viewportSize = camera.ViewportSize
		local scaleFactor = math.min(
			viewportSize.X / baseResolution.X,
			viewportSize.Y / baseResolution.Y
		)
	
		scale.Scale = scaleFactor
	end
	
	-- Run initially
	updateScale()
	
	-- Update when screen size changes
	workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(function()
		updateScale()
	end)
	
	workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(function()
		updateScale()
	end)
	
	button.MouseButton1Click:Connect(function()
		local player = game.Players.LocalPlayer
		local character = player.Character or player.CharacterAdded:Wait()
		local humanoid = character:WaitForChild("Humanoid")
	
		local speed = tonumber(textBox.Text)
	
		if speed then
			humanoid.WalkSpeed = speed
		else
			warn("Please enter a valid number!")
		end
	end)
	
	button2.MouseButton1Click:Connect(function()
		local player = game.Players.LocalPlayer
		local character = player.Character or player.CharacterAdded:Wait()
		local humanoid = character:WaitForChild("Humanoid")
	
		humanoid.WalkSpeed = 16 -- default is 16
	end)
	
end
